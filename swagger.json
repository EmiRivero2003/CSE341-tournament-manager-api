  },
  "components": {
    "securitySchemes": {
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "connect.sid",
        "description": "Session cookie created after Google OAuth authentication"
      }
    },
    "parameters": {
      "DocumentId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "MongoDB document ID",
        "schema": {
          "type": "string",
          "example": "64f1234567890abcdef12345"
        }
      }
    },
    "schemas": {
      "TournamentInput": {
        "type": "object",
        "required": [
          "name",
          "season",
          "country",
          "startDate",
          "endDate",
          "organizer"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Uruguayan Championship"
          },
          "season": {
            "type": "string",
            "example": "2026"
          },
          "country": {
            "type": "string",
            "example": "Uruguay"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "example": "2026-02-01"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "example": "2026-12-15"
          },
          "status": {
            "type": "string",
            "enum": ["scheduled", "active", "completed", "cancelled"],
            "example": "active"
          },
          "organizer": {
            "type": "string",
            "example": "Uruguayan Football Association"
          },
          "participatingTeams": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": []
          }
        }
      },
      "Tournament": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TournamentInput"
          },
          {
            "$ref": "#/components/schemas/DatabaseFields"
          }
        ]
      },
      "TeamInput": {
        "type": "object",
        "required": [
          "name",
          "city",
          "country",
          "foundedYear",
          "stadium",
          "coach",
          "league",
          "website"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Montevideo Lions"
          },
          "city": {
            "type": "string",
            "example": "Montevideo"
          },
          "country": {
            "type": "string",
            "example": "Uruguay"
          },
          "foundedYear": {
            "type": "integer",
            "minimum": 1850,
            "example": 2020
          },
          "stadium": {
            "type": "string",
            "example": "Rivera Stadium"
          },
          "coach": {
            "type": "string",
            "example": "Martin Silva"
          },
          "league": {
            "type": "string",
            "example": "Uruguayan First Division"
          },
          "website": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/montevideo-lions"
          }
        }
      },
      "Team": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TeamInput"
          },
          {
            "$ref": "#/components/schemas/DatabaseFields"
          }
        ]
      },
      "PlayerInput": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "dateOfBirth",
          "nationality",
          "position",
          "shirtNumber",
          "team"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50,
            "example": "Federico"
          },
          "lastName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50,
            "example": "Valverde"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "example": "1998-07-22"
          },
          "nationality": {
            "type": "string",
            "example": "Uruguay"
          },
          "position": {
            "type": "string",
            "enum": ["goalkeeper", "defender", "midfielder", "forward"],
            "example": "midfielder"
          },
          "shirtNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99,
            "example": 8
          },
          "team": {
            "type": "string",
            "description": "Team MongoDB ID",
            "example": "64f1234567890abcdef12345"
          },
          "status": {
            "type": "string",
            "enum": ["active", "injured", "suspended", "inactive"],
            "default": "active",
            "example": "active"
          }
        }
      },
      "Player": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PlayerInput"
          },
          {
            "$ref": "#/components/schemas/DatabaseFields"
          }
        ]
      },
      "MatchInput": {
        "type": "object",
        "required": [
          "tournament",
          "homeTeam",
          "awayTeam",
          "matchDate",
          "venue",
          "round",
          "status"
        ],
        "properties": {
          "tournament": {
            "type": "string",
            "description": "Tournament MongoDB ID",
            "example": "64f1234567890abcdef12345"
          },
          "homeTeam": {
            "type": "string",
            "description": "Home team MongoDB ID",
            "example": "64f1234567890abcdef12346"
          },
          "awayTeam": {
            "type": "string",
            "description": "Away team MongoDB ID. It must be different from homeTeam.",
            "example": "64f1234567890abcdef12347"
          },
          "matchDate": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-15T20:00:00.000Z"
          },
          "venue": {
            "type": "string",
            "example": "Centenario Stadium"
          },
          "round": {
            "type": "string",
            "example": "Group Stage - Round 1"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "in_progress",
              "completed",
              "postponed",
              "cancelled"
            ],
            "example": "scheduled"
          },
          "homeScore": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "example": 0
          },
          "awayScore": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "example": 0
          }
        }
      },
      "Match": {
        "allOf": [
          {
            "$ref": "#/components/schemas/MatchInput"
          },
          {
            "$ref": "#/components/schemas/DatabaseFields"
          }
        ]
      },
      "DatabaseFields": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "64f1234567890abcdef12345"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuthUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "example": "Emiliano Rivero"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "photo": {
            "type": "string",
            "format": "uri",
            "nullable": true
          }
        }
      },
      "AuthProfile": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Authenticated successfully."
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
