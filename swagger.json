          }
        }
      }
    },
    "/matches/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DocumentId"
        }
      ],
      "get": {
        "tags": ["Matches"],
        "summary": "Get a match by ID",
        "responses": {
          "200": {
            "description": "Match returned successfully",
            "content": {
              "application/json": {
                "schema": {
