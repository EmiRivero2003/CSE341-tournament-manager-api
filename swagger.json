{
  "openapi": "3.0.3",
  "info": {
    "title": "Tournament Manager API",
    "version": "1.0.0",
    "description": "REST API for managing football tournaments, teams, players, and matches.",
    "contact": {
      "name": "Emiliano Rivero"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Google OAuth authentication and session operations"
    },
    {
      "name": "Tournaments",
      "description": "Tournament CRUD operations"
    },
    {
      "name": "Teams",
      "description": "Team CRUD operations"
    },
    {
      "name": "Players",
      "description": "Player CRUD operations"
    },
    {
      "name": "Matches",
      "description": "Match CRUD operations"
    }
  ],
  "paths": {
    "/auth/google": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Log in with Google",
        "description": "Starts Google OAuth authentication. Open this route directly in the browser.",
        "responses": {
          "302": {
            "description": "Redirects the user to Google"
          }
        }
      }
    },
    "/auth/profile": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get the authenticated user",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated user returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthProfile"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Log out",
        "security": [
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logged out successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/tournaments": {
      "get": {
        "tags": ["Tournaments"],
        "summary": "Get all tournaments",
        "responses": {
          "200": {
            "description": "Tournament list returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Tournament"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "tags": ["Tournaments"],
        "summary": "Create a tournament",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TournamentInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tournament created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tournament"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/tournaments/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DocumentId"
        }
      ],
      "get": {
        "tags": ["Tournaments"],
        "summary": "Get a tournament by ID",
        "responses": {
          "200": {
            "description": "Tournament returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tournament"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "tags": ["Tournaments"],
        "summary": "Update a tournament",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TournamentInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tournament updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tournament"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "tags": ["Tournaments"],
        "summary": "Delete a tournament",
        "responses": {
          "200": {
            "description": "Tournament deleted successfully"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/teams": {
